{
  "name": "agent-trust",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trust & Authorization Fabric for AI agents — monorepo root",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "policy:fmt": "opa fmt --fail policies/",
    "policy:check": "opa check policies/",
    "policy:test": "opa test --fail-on-empty policies/",
    "setup:opa": "node scripts/setup-opa.mjs",
    "build:policy": "node scripts/build-policy.mjs",
    "demo:e2e": "echo \"demo:e2e lands with the cross-agent E2E phase — see docs/roadmap.md build order step 10\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "fast-check": "^4.10.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
