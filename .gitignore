# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
*.tsbuildinfo
# Un-committed policy builds. The release artifact at
# artifacts/policy/policy.wasm IS committed and hash-pinned by its
# manifest (scripts/build-policy.mjs).
policy.wasm
!artifacts/policy/policy.wasm
policyManifest.json

# Generated attack-suite reports (regenerated by demo:attacks; the
# committed artifacts/policy/ is NOT here — only the volatile reports).
artifacts/attacks/

# Environment & secrets — never commit key material
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
keys/
secrets/

# Local demo identity material (private keys + generated DID docs).
# demo:did:init writes here; nothing under it may ever be committed.
.local/

# Databases & runtime state
*.sqlite
*.db
data/

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Coverage
coverage/
.nyc_output/

# Editors & OS
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# OPA
opa/bundles/
tools/bin/
